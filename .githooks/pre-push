#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
if test -n "$(git status --porcelain)"; then
    printf '%s\n' 'Pre-push refuses a dirty worktree: verification must match the pushed commit.' >&2
    exit 1
fi
head=$(git rev-parse HEAD)
check=0
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    if test "$local_oid" != "$head"; then
        printf '%s\n' 'Pre-push only verifies the checked-out HEAD; use its clean worktree.' >&2
        exit 1
    fi
    check=1
done
if test "$check" = 1; then
    sh scripts/check.sh
fi
