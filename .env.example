# Copy to .env and fill in. Never commit .env. Values are placeholders.
# Keep the file private: chmod 600 .env
# Compose reads it for substitution and passes it to the bot containers as env_file,
# so write values without quotes and without spaces around "=".

# --- Required -------------------------------------------------------------
# Token from BotFather. The number before the colon is the bot ID and must equal
# expected_bot_id in settings.toml.
ARCHIVE_BOT_TOKEN=123456:REPLACE_ME

# Database connection string. For the bundled Postgres container the host is "db",
# the user and database are "archive", the password must equal POSTGRES_PASSWORD.
# For an external Postgres/Supabase put its connection string here (docs/database.md).
ARCHIVE_DATABASE_DSN=postgresql://archive:REPLACE_ME_HEX_PASSWORD@db:5432/archive

# Password of the bundled Postgres container (only the first start uses it).
# Generate: openssl rand -hex 24   (hex keeps it safe inside the URL above)
POSTGRES_PASSWORD=REPLACE_ME_HEX_PASSWORD

# Host directory for all data: db/ (Postgres files), media/ (downloaded files),
# exports/ (CLI export output). Keep it outside the git checkout.
OKO_DATA_DIR=/var/lib/oko

# --- Optional: transcription (off unless enabled in settings.toml) ---------
# Groq: voice/video up to 20 000 000 bytes. AssemblyAI: larger files.
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=

# --- Optional: Compose paths ----------------------------------------------
# Settings file mounted into the containers (default ./settings.toml).
# ARCHIVE_CONFIG_FILE=./settings.toml
# Env file given to the containers (default .env).
# ARCHIVE_ENV_FILE=.env
# Image tag built from the Dockerfile (default oko-telegram-bot:local).
# ARCHIVE_IMAGE=oko-telegram-bot:local

# --- Optional: PostgreSQL memory profile of the bundled db container --------
# Defaults are a starting point for a small server (one owner, a few chats).
# Change them only after checking memory on your own server (docs/database.md, section 1).
# PG_SHARED_BUFFERS=64MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=32MB
# PG_EFFECTIVE_CACHE_SIZE=192MB
# PG_MAX_CONNECTIONS=20
# DB_MEM_LIMIT=384m
